# ⚠️ NEVER commit actual secrets to this repository
# Copy this file to .env and fill with actual values

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/projectselyon
DATABASE_ENCRYPTION_KEY=your_32_byte_hex_key_here

# Solana Blockchain
SOLANA_NETWORK=mainnet-beta
# Use secrets manager, NEVER put private key here
SOLANA_WALLET_ADDRESS=H4nWSLrp1x7dZoNAamQXuMSdJ1s2JFhBfRX1Eeoib2yo

# JWT & Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRY=24h

# Admin Configuration
ADMIN_PASSWORD_HASH=bcrypt_hash_here
MFA_ENABLED=true

# Vault/Secrets Manager
VAULT_ENABLED=true
VAULT_ADDR=https://your-vault-server.com
VAULT_TOKEN=your_vault_token_here

# Encryption
ENCRYPTION_ALGORITHM=aes-256-gcm
ENCRYPTION_KEY_ROTATION_DAYS=90

# Audit Logging
AUDIT_LOG_LEVEL=INFO
SENSITIVE_AUDIT_ENABLED=true

# Security
RATE_LIMIT_ENABLED=true
SESSION_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=16
